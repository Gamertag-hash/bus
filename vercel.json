{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "env": {
    "DATABASE_URL": "@database_url",
    "JWT_SECRET": "@jwt_secret",
    "ADMIN_EMAIL": "@admin_email",
    "ADMIN_PASSWORD": "@admin_password"
  },
  "framework": "vite",
  "functions": {
    "backend/src/index.ts": {
      "runtime": "nodejs20.x"
    }
  }
}
